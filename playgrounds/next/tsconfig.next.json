{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // App code, not a library: no declaration output, so no explicit return types needed.
    "declaration": false,
    "isolatedDeclarations": false,
    "types": ["node"],
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
