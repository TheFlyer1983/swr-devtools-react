{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // App code, not a library: no declaration output, so no explicit return types needed.
    "declaration": false,
    "isolatedDeclarations": false,
    "types": ["astro/client"],
    // Typecheck against the package's source so it doesn't depend on
    // `pnpm build` having run first. The site itself builds from dist.
    "paths": {
      "swr-devtools-react/production": ["../../packages/react/src/production.ts"]
    }
  },
  "include": ["src", "astro.config.ts", ".astro/types.d.ts"],
  "exclude": ["dist"]
}
