{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/.next/**", "**/next-env.d.ts"],
  "overrides": [
    {
      "files": [
        "**/vitest.setup.ts",
        "playgrounds/*/src/main.tsx",
        "playgrounds/next/app/layout.tsx",
        "playgrounds/next/pages/_app.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
